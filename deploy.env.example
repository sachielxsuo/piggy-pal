# PiggyPal 部署配置模板
#
# 用法：
#   cp deploy.env.example deploy.env    # 然后填上自己的值
#
# deploy.env 已在 .gitignore 里，**永远不会进仓库**；这个模板才会被提交。
# release_apk.sh / build.sh / server/deploy/deploy.sh 都会自动读取它，
# 命令行环境变量优先级更高（临时换服务器：PIGGYPAL_SERVER=1.2.3.4 ./deploy.sh）。

# 服务器公网 IP 或域名（必填）
PIGGYPAL_SERVER=

# ssh 登录用户（默认 root）
PIGGYPAL_USER=root

# 对外访问域名，客户端打包时会注入成 API 地址（必填）
PIGGYPAL_DOMAIN=

# 服务端安装目录（默认 /opt/piggy-pal）
PIGGYPAL_REMOTE_DIR=/opt/piggy-pal

# 客户端 API 地址；不填则用 https://$PIGGYPAL_DOMAIN
# 需要单独指定时（比如先指向预发环境）取消注释：
# PIGGYPAL_API_BASE=https://piggy.example.com
