# 腾讯云 CAM 密钥（TTS 语音合成 + ASR 一句话识别 用）
# 获取：腾讯云控制台 → 访问管理 → API 密钥管理
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 地域（TTS/ASR 服务所在地域，默认广州）
TENCENTCLOUD_REGION=ap-guangzhou

# DeepSeek 大模型（OpenAI 兼容接口）
# 获取：platform.deepseek.com → API Keys → 创建 key（sk- 开头）
LLM_TOKEN=
# 以下一般不用改
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ASR 识别引擎：16k_zh-PY(中英粤) / 16k_zh(中文) / 16k_en(英语)
ASR_ENGINE=16k_zh-PY

# 全站共享访问令牌：客户端用请求头 X-API-Token 携带
# 生成：openssl rand -hex 24
# 留空 = 关闭校验（仅限本地开发）；公网部署务必设置
API_TOKEN=

# 服务端口
PORT=18080
# 数据目录（SQLite + TTS 缓存落盘位置）
DATA_DIR=./data

# 注：实时流式 ASR（TRTC）暂未接入，后续可选；当前用「一句话识别」（CAM 密钥，按住说话场景够用）
